  "projects_list_count": [
    {
      "declarations": [
        "input count",
        "input shown",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{shown} project",
        "countPlural=other": "{shown} projects"
      }
    }
  ],
  "projects_task_count": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{countShown} task",
        "countPlural=other": "{countShown} tasks"
      }
    }
  ],
  "projects_unrated_entries": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{countShown} entry has no rate and will be billed at 0.",
        "countPlural=other": "{countShown} of these entries have no rate and will be billed at 0."
      }
    }
  ],
  "projects_bill_summary": [
    {
      "declarations": [
        "input count",
        "input entries",
        "input hours",
        "input value",
        "input date",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{entries} entry, {hours}, {value} not yet billed, up to {date}.",
        "countPlural=other": "{entries} entries, {hours}, {value} not yet billed, up to {date}."
      }
    }
  ],
  "projects_retainer_used_in": [
    {
      "declarations": [
        "input count",
        "input month",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{countShown} hour in {month}",
        "countPlural=other": "{countShown} hours in {month}"
      }
    }
  ],
  "projects_retainer_used_of": [
    {
      "declarations": [
        "input count",
        "input month",
        "input used",
        "local countPlural = count: plural",
        "local countShown = count: number",
        "local usedShown = used: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{usedShown} of {countShown} hour used in {month}",
        "countPlural=other": "{usedShown} of {countShown} hours used in {month}"
      }
    }
  ],
  "projects_retainer_overage": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{countShown} hour over the allowance so far",
        "countPlural=other": "{countShown} hours over the allowance so far"
      }
    }
  ],
  "projects_retainer_overage_amount": [
    {
      "declarations": [
        "input count",
        "input amount",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{countShown} hour over the allowance so far, {amount}",
        "countPlural=other": "{countShown} hours over the allowance so far, {amount}"
      }
    }
  ],
  "projects_retainer_carried": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{countShown} hour carried in from earlier months",
        "countPlural=other": "{countShown} hours carried in from earlier months"
      }
    }
  ]
}
