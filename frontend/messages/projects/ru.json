  "projects_list_count": [
    {
      "declarations": [
        "input count",
        "input shown",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{shown} проект",
        "countPlural=few": "{shown} проекта",
        "countPlural=many": "{shown} проектов",
        "countPlural=other": "{shown} проекта"
      }
    }
  ],
  "projects_task_count": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{countShown} задача",
        "countPlural=few": "{countShown} задачи",
        "countPlural=many": "{countShown} задач",
        "countPlural=other": "{countShown} задачи"
      }
    }
  ],
  "projects_unrated_entries": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{countShown} запись без ставки, она будет выставлена в счёт по 0.",
        "countPlural=few": "{countShown} записи без ставки, они будут выставлены в счёт по 0.",
        "countPlural=many": "{countShown} записей без ставки, они будут выставлены в счёт по 0.",
        "countPlural=other": "{countShown} записи без ставки, они будут выставлены в счёт по 0."
      }
    }
  ],
  "projects_bill_summary": [
    {
      "declarations": [
        "input count",
        "input entries",
        "input hours",
        "input value",
        "input date",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{entries} запись, {hours}, {value} ещё не выставлены в счёт, по {date}.",
        "countPlural=few": "{entries} записи, {hours}, {value} ещё не выставлены в счёт, по {date}.",
        "countPlural=many": "{entries} записей, {hours}, {value} ещё не выставлены в счёт, по {date}.",
        "countPlural=other": "{entries} записи, {hours}, {value} ещё не выставлены в счёт, по {date}."
      }
    }
  ],
  "projects_retainer_used_in": [
    {
      "declarations": [
        "input count",
        "input month",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{countShown} час за {month}",
        "countPlural=few": "{countShown} часа за {month}",
        "countPlural=many": "{countShown} часов за {month}",
        "countPlural=other": "{countShown} часа за {month}"
      }
    }
  ],
  "projects_retainer_used_of": [
    {
      "declarations": [
        "input count",
        "input month",
        "input used",
        "local countPlural = count: plural",
        "local countShown = count: number",
        "local usedShown = used: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "Использовано {usedShown} из {countShown} часа за {month}",
        "countPlural=few": "Использовано {usedShown} из {countShown} часов за {month}",
        "countPlural=many": "Использовано {usedShown} из {countShown} часов за {month}",
        "countPlural=other": "Использовано {usedShown} из {countShown} часа за {month}"
      }
    }
  ],
  "projects_retainer_overage": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "Переработка пока: {countShown} час",
        "countPlural=few": "Переработка пока: {countShown} часа",
        "countPlural=many": "Переработка пока: {countShown} часов",
        "countPlural=other": "Переработка пока: {countShown} часа"
      }
    }
  ],
  "projects_retainer_overage_amount": [
    {
      "declarations": [
        "input count",
        "input amount",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "Переработка пока: {countShown} час, {amount}",
        "countPlural=few": "Переработка пока: {countShown} часа, {amount}",
        "countPlural=many": "Переработка пока: {countShown} часов, {amount}",
        "countPlural=other": "Переработка пока: {countShown} часа, {amount}"
      }
    }
  ],
  "projects_retainer_carried": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{countShown} час перенесён с прошлых месяцев",
        "countPlural=few": "{countShown} часа перенесены с прошлых месяцев",
        "countPlural=many": "{countShown} часов перенесено с прошлых месяцев",
        "countPlural=other": "{countShown} часа перенесено с прошлых месяцев"
      }
    }
  ]
}
