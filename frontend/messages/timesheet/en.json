  "timesheet_timers_running": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local countShown = count: number"
      ],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Timer running",
        "countPlural=other": "{countShown} timers running"
      }
    }
  ],
