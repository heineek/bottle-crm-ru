{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "en",
  "locales": [
    "en"
  ],
  "modules": [
    "./node_modules/@inlang/plugin-message-format/dist/index.js"
  ],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/{locale}.json",
      "./messages/app/{locale}.json",
      "./messages/timesheet/{locale}.json",
      "./messages/tickets/{locale}.json",
      "./messages/tasks/{locale}.json",
      "./messages/solutions/{locale}.json",
      "./messages/profile/{locale}.json",
      "./messages/leads/{locale}.json",
      "./messages/contacts/{locale}.json",
      "./messages/accounts/{locale}.json",
      "./messages/pipeline/{locale}.json",
      "./messages/projects/{locale}.json"
    ]
  }
}
