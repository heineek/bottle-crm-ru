msgid "Not a valid IANA timezone."
msgstr "Недопустимый часовой пояс IANA."

msgid "Open and close must be both set or both null."
msgstr "Время открытия и закрытия должно быть указано вместе или не указано вовсе."

msgid "Close time must be after open time."
msgstr "Время закрытия должно быть позже времени открытия."

msgid "Only admins can update business hours."
msgstr "Изменять рабочие часы могут только администраторы."
