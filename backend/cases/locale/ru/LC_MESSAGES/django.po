msgstr "Доступ запрещён"

msgid "Mailbox not found"
msgstr "Почтовый ящик не найден"

msgid "Mailbox deleted"
msgstr "Почтовый ящик удалён"

#, python-format
msgid ""
"This ticket is in the %(pipeline)s pipeline. Move it to one of that "
"pipeline's stages."
msgstr ""
"Это обращение находится в воронке «%(pipeline)s». Переместите его на один из "
"этапов этой воронки."

#, python-format
msgid "Stage '%(stage)s' has reached its WIP limit of %(limit)s"
msgstr "Этап «%(stage)s» достиг лимита WIP: %(limit)s"

msgid "Case moved successfully"
msgstr "Обращение перемещено"

msgid "Only admins can create pipelines"
msgstr "Создавать воронки могут только администраторы"

#, python-format
msgid "Cannot delete pipeline with %(count)s cases. Move cases first."
msgid_plural "Cannot delete pipeline with %(count)s cases. Move cases first."
msgstr[0] ""
"Нельзя удалить воронку, в которой %(count)s обращение. Сначала переместите "
"обращения."
msgstr[1] ""
"Нельзя удалить воронку, в которой %(count)s обращения. Сначала переместите "
"обращения."
msgstr[2] ""
"Нельзя удалить воронку, в которой %(count)s обращений. Сначала переместите "
"обращения."

#, python-format
msgid "Cannot delete stage with %(count)s cases. Move cases first."
msgid_plural "Cannot delete stage with %(count)s cases. Move cases first."
msgstr[0] ""
"Нельзя удалить этап, на котором %(count)s обращение. Сначала переместите "
"обращения."
msgstr[1] ""
"Нельзя удалить этап, на котором %(count)s обращения. Сначала переместите "
"обращения."
msgstr[2] ""
"Нельзя удалить этап, на котором %(count)s обращений. Сначала переместите "
"обращения."

msgid "Send every stage of this pipeline exactly once, in the new order."
msgstr "Передайте каждый этап этой воронки ровно один раз, в новом порядке."

msgid "Stages reordered successfully"
msgstr "Порядок этапов изменён"

msgid "Only an admin can approve or publish a knowledge-base article."
msgstr "Одобрять и публиковать статьи базы знаний может только администратор."

msgid "You must be an admin, or the creator of this ticket, to merge it."
msgstr "Объединить это обращение может только администратор или его автор."

msgid "Cannot merge a ticket into itself."
msgstr "Нельзя объединить обращение с самим собой."

msgid "Ticket not found."
msgstr "Обращение не найдено."

msgid "You must be an admin, or the creator of both tickets, to merge them."
msgstr ""
"Объединить эти обращения может только администратор или автор обоих "
"обращений."

msgid "Tickets already merged."
msgstr "Обращения уже объединены."

msgid "Source ticket is already merged into a different ticket."
msgstr "Исходное обращение уже объединено с другим обращением."

msgid "Target ticket has already been merged elsewhere."
msgstr "Целевое обращение уже объединено с другим обращением."

msgid "Tickets merged"
msgstr "Обращения объединены"

