#, python-format
msgid ""
"An approval is required before this case can be closed (rule: %(rule)s)."
msgstr "Чтобы закрыть это обращение, нужно согласование (правило: %(rule)s)."

#, python-format
msgid "Select at most %(max)s tickets at a time."
msgstr "Выберите не больше %(max)s обращений за раз."

msgid "ids required"
msgstr "Укажите ids"

msgid "fields required"
msgstr "Укажите fields"

#, python-format
msgid "Unsupported fields: %(fields)s"
msgstr "Неподдерживаемые поля: %(fields)s"

