msgstr "Недействительная ссылка на опрос."

msgid "Survey link is no longer valid."
msgstr "Ссылка на опрос больше не действует."

#, python-format
msgid "%(org)s support"
msgstr "Поддержка %(org)s"

msgid "your support team"
msgstr "ваша служба поддержки"

msgid "Survey is locked. Edit window has closed."
msgstr "Опрос закрыт: время для изменения ответа истекло."

#, python-format
msgid "rating must be an integer %(min)s-%(max)s"
msgstr "Оценка должна быть целым числом от %(min)s до %(max)s"

#, python-format
msgid "rating must be %(min)s..%(max)s"
msgstr "Оценка должна быть от %(min)s до %(max)s"

msgid "Escalation policy not found"
msgstr "Политика эскалации не найдена"

msgid "Escalation policy deleted"
msgstr "Политика эскалации удалена"

msgid "Not found"
msgstr "Не найдено"

