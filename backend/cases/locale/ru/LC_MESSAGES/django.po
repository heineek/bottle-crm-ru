#, python-format
msgid "Case type must be one of: %(values)s"
msgstr "Тип обращения должен быть одним из: %(values)s"

msgid "Date must be a real date in YYYY-MM-DD format"
msgstr "Укажите существующую дату в формате YYYY-MM-DD"

#, python-format
msgid "No account you can open is named '%(name)s'"
msgstr "Нет доступной вам компании с названием «%(name)s»"

#, python-format
msgid "'%(email)s' is not a valid email"
msgstr "«%(email)s» не является корректным email"

#, python-format
msgid "No contact you can open has the email '%(email)s'"
msgstr "Нет доступного вам контакта с email «%(email)s»"

#, python-format
msgid "No active member with email '%(email)s'"
msgstr "Нет активного участника с email «%(email)s»"

#, python-format
msgid "No team named '%(name)s'"
msgstr "Нет команды с названием «%(name)s»"

#, python-format
msgid "Tag '%(name)s': %(error)s"
msgstr "Тег «%(name)s»: %(error)s"

msgid "Fix the invalid rows before importing"
msgstr "Исправьте ошибочные строки перед импортом"

#, python-format
msgid ""
"This article is published, so it cannot be moved back to '%(status)s'. "
"Unpublish it first."
msgstr ""
"Эта статья опубликована, поэтому её нельзя вернуть в статус «%(status)s». "
"Сначала снимите её с публикации."

msgid ""
"Only approved solutions can be published. Please set status to 'approved' "
"first."
msgstr ""
"Опубликовать можно только одобренную статью. Сначала установите статус "
"«approved»."

msgid "Only approved solutions can be published. Please approve it first."
msgstr "Опубликовать можно только одобренную статью. Сначала одобрите её."

msgid "Not good"
msgstr "Плохо"

msgid "Great"
msgstr "Отлично"

msgid "Assigned to case."
msgstr "Вам назначено обращение."

#, python-format
msgid "How did we do?, %(case)s"
msgstr "Как мы справились? %(case)s"

msgid "A contact"
msgstr "Контакт"

#, python-format
msgid "Your request is now %(status)s."
msgstr "Статус вашего запроса: %(status)s."

#, python-format
msgid "How did we do on \"%(name)s\"?"
msgstr "Как мы справились с обращением «%(name)s»?"

msgid "How did we do?"
msgstr "Как мы справились?"

#, python-format
msgid "Hi %(name)s,"
msgstr "Здравствуйте, %(name)s!"

msgid "Hi there,"
msgstr "Здравствуйте!"

#, python-format
msgid ""
"Your case with %(org_name)s is closed. Tap a star to rate it, and we will "
"only ask you this once."
msgstr ""
"Ваше обращение в %(org_name)s закрыто. Нажмите на звезду, чтобы оценить его. "
"Мы спросим об этом только один раз."

msgid "Case"
msgstr "Обращение"

#, python-format
msgid ""
"Or <a href=\"%(link)s\" style=\"color:#EA580C;\">open the survey</a> to leave"
" a comment as well."
msgstr ""
"Или <a href=\"%(link)s\" style=\"color:#EA580C;\">откройте опрос</a>, чтобы "
"также оставить комментарий."

#, python-format
msgid "Hello %(contact_name)s,"
msgstr "Здравствуйте, %(contact_name)s!"

#, python-format
msgid "%(author_name)s replied to your request \"%(case_name)s\":"
msgstr "%(author_name)s ответил(а) на ваш запрос «%(case_name)s»:"

#, python-format
msgid "Your request \"%(case_name)s\" is now <strong>%(case_status)s</strong>."
msgstr ""
"Статус вашего запроса «%(case_name)s»: <strong>%(case_status)s</strong>."

msgid ""
"You can reply to this email, and your reply will be added to the request."
msgstr ""
"Вы можете ответить на это письмо, и ваш ответ будет добавлен к запросу."

msgid ""
"Please do not reply to this email. To answer, use the support portal link "
"below."
msgstr ""
"Пожалуйста, не отвечайте на это письмо. Чтобы ответить, воспользуйтесь "
"ссылкой на портал поддержки ниже."

#, python-format
msgid "View the request in the %(org_name)s support portal"
msgstr "Открыть запрос на портале поддержки %(org_name)s"

msgid ""
"You will be asked to sign in, and we will email you a six digit code to do "
"that."
msgstr ""
"Вам нужно будет войти: для этого мы отправим вам на почту шестизначный код."

msgid "No ticket"
msgstr "Без обращения"

msgid "No project"
msgstr "Без проекта"

msgid "No account"
msgstr "Без компании"

#, python-format
msgid "group_by must be one of %(groupings)s, not %(value)s."
msgstr "group_by должен быть одним из значений %(groupings)s, а не %(value)s."

msgid "Unknown agent"
msgstr "Неизвестный агент"

#, python-format
msgid "Invalid date %(value)s; expected YYYY-MM-DD."
msgstr "Недопустимая дата %(value)s, ожидается YYYY-MM-DD."

msgid "Only admins can report on another profile's time."
msgstr "Отчёт по времени другого профиля доступен только администраторам."

msgid "billable must be 'true' or 'false'."
msgstr "billable должен быть «true» или «false»."

msgid "end must be on or after start."
msgstr "end должно быть не раньше start."

msgid "Send true or false."
msgstr "Передайте true или false."

msgid "You already have a running timer."
msgstr "У вас уже запущен таймер."

msgid "Not found."
msgstr "Не найдено."

msgid "Not authorized to edit this entry."
msgstr "У вас нет прав на изменение этой записи."

msgid "Cannot edit an entry that has been invoiced."
msgstr "Нельзя изменить запись, по которой выставлен счёт."

msgid "Only time on a project can name a task."
msgstr "Указать задачу можно только для времени по проекту."

msgid "Not authorized to delete this entry."
msgstr "У вас нет прав на удаление этой записи."

msgid "Cannot delete an entry that has been invoiced."
msgstr "Нельзя удалить запись, по которой выставлен счёт."

msgid "Not authorized to stop this entry."
msgstr "У вас нет прав на остановку этой записи."

msgid "Timer is already stopped."
msgstr "Таймер уже остановлен."

msgid "Only admins can view another profile's timesheet."
msgstr "Учёт времени другого профиля доступен только администраторам."

msgid "This ticket is not currently merged."
msgstr "Это обращение сейчас не объединено."

msgid ""
"Unmerge metadata is missing for this ticket (it was merged before unmerge "
"tracking was added). Please restore manually."
msgstr ""
"Для этого обращения нет данных для разъединения (оно было объединено до того,"
" как они начали сохраняться). Восстановите его вручную."

msgid "Target ticket no longer exists; cannot unmerge."
msgstr "Целевого обращения больше нет, разъединить невозможно."

msgid "You must be an admin, or the creator of both tickets, to unmerge them."
msgstr ""
"Разъединить эти обращения может только администратор или автор обоих "
"обращений."

msgid "Tickets unmerged"
msgstr "Обращения разъединены"

msgid "Case Created Successfully"
msgstr "Обращение создано"

msgid "Case Updated Successfully"
msgstr "Обращение обновлено"

msgid "This ticket"
msgstr "Это обращение"

msgid "Case Deleted Successfully."
msgstr "Обращение удалено."

msgid "Comment Submitted"
msgstr "Комментарий добавлен"

msgid "You don't have permission to perform this action."
msgstr "У вас нет прав на это действие."

msgid "Comment Updated"
msgstr "Комментарий обновлён"

msgid "Comment Deleted Successfully"
msgstr "Комментарий удалён"

msgid "You do not have permission to perform this action"
msgstr "У вас нет прав на это действие"

msgid "Attachment Deleted Successfully"
msgstr "Вложение удалено"

msgid "solution_id required"
msgstr "Укажите solution_id"

msgid "Solution not found"
msgstr "Статья не найдена"

msgid "An app member cannot watch a ticket."
msgstr "Участник-приложение не может отслеживать обращение."

msgid "A ticket becomes Duplicate only by merging it into another ticket."
msgstr ""
"Обращение получает статус «Дубликат» только при объединении с другим "
"обращением."

msgid ""
"This ticket is merged into another. Unmerge it first to change its status."
msgstr ""
"Это обращение объединено с другим. Чтобы изменить его статус, сначала "
"разъедините их."
