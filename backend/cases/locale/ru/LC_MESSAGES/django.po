msgstr "Сгенерированный адрес нельзя изменить."

#, python-format
msgid ""
"Addresses at %(domain)s can only be generated. Choose \"Generate an address\""
" instead."
msgstr ""
"Адреса в домене %(domain)s можно только сгенерировать. Выберите "
"«Сгенерировать адрес»."

#, python-format
msgid "A mailbox with address %(address)s already exists for this org."
msgstr "Почтовый ящик с адресом %(address)s в этой организации уже есть."

msgid ""
"Enter an SNS topic ARN, like arn:aws:sns:us-east-1:123456789012:inbound-mail."
msgstr ""
"Введите ARN темы SNS, например arn:aws:sns:us-east-1:123456789012:inbound-"
"mail."

msgid "An address is generated only when the mailbox is created."
msgstr "Адрес генерируется только при создании почтового ящика."

msgid ""
"This server has no inbound email domain, so it cannot make an address. Type "
"one instead."
msgstr ""
"На этом сервере не настроен домен для входящей почты, поэтому создать адрес "
"нельзя. Введите адрес вручную."

msgid "Leave the address empty to have one generated."
msgstr "Оставьте адрес пустым, чтобы он был сгенерирован."

msgid "This field is required."
msgstr "Обязательное поле."

msgid "A generated address receives its mail through AWS SES."
msgstr "Сгенерированный адрес получает почту через AWS SES."

msgid "No free address was found. Try again."
msgstr "Свободный адрес не найден. Попробуйте ещё раз."

msgid "conditions must be a list of objects."
msgstr "conditions должен быть списком объектов."

#, python-format
msgid "conditions[%(index)s] must be an object."
msgstr "conditions[%(index)s] должен быть объектом."

#, python-format
msgid "conditions[%(index)s].field is required."
msgstr "Укажите conditions[%(index)s].field."

#, python-format
msgid "conditions[%(index)s].field %(field)s is not supported."
msgstr "conditions[%(index)s].field %(field)s не поддерживается."

#, python-format
msgid "conditions[%(index)s].op %(op)s is not supported."
msgstr "conditions[%(index)s].op %(op)s не поддерживается."

#, python-format
msgid "conditions[%(index)s].value is required."
msgstr "Укажите conditions[%(index)s].value."

#, python-format
msgid "conditions[%(index)s].value %(problem)s."
msgstr "conditions[%(index)s].value %(problem)s."

msgid "by_team strategy requires target_team_id."
