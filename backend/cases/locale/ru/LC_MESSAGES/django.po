msgstr "Для детализации бэклога укажите bucket=YYYY-MM-DD"

msgid "agents drilldown requires a bucket=<profile_id>"
msgstr "Для детализации по сотрудникам укажите bucket=<profile_id>"

#, python-format
msgid "unknown metric: %(metric)s"
msgstr "Неизвестная метрика: %(metric)s"

#, python-format
msgid ""
"'%(value)s' is not a valid date. Use YYYY-MM-DD or an ISO-8601 timestamp."
msgstr ""
"«%(value)s» не является датой. Используйте формат YYYY-MM-DD или метку "
"времени ISO-8601."

#, python-format
msgid "'%(value)s' is not a whole number of days."
msgstr "«%(value)s» не является целым числом дней."

msgid "Admin access required"
msgstr "Требуются права администратора"

msgid "only fmt=csv is supported"
msgstr "Поддерживается только fmt=csv"

msgid "Approver is outside this org."
msgstr "Согласующий не состоит в этой организации."

msgid "Team is outside this org."
msgstr "Команда не относится к этой организации."

msgid "Rule not found"
msgstr "Правило не найдено"

msgid "Rule not found or inactive."
msgstr "Правило не найдено или неактивно."

msgid "Rule does not match this case."
msgstr "Правило не подходит для этого обращения."

msgid "No active approval rule matches this case."
msgstr "Для этого обращения нет активного правила согласования."

msgid "An approval is already pending for this case."
msgstr "Для этого обращения уже ожидается согласование."

msgid "Approval not found"
msgstr "Согласование не найдено"

#, python-format
msgid "Approval already %(state)s."
msgstr "Решение по этому запросу уже принято: %(state)s."

msgid "You are not an approver for this rule."
msgstr "Вы не являетесь согласующим по этому правилу."

msgid "You cannot approve your own request; another approver must decide it."
msgstr ""
"Нельзя согласовать собственный запрос: решение должен принять другой "
"согласующий."

msgid "Rejection reason is required."
msgstr "Укажите причину отклонения."

msgid "You cannot reject your own request; another approver must decide it."
msgstr ""
"Нельзя отклонить собственный запрос: решение должен принять другой "
"согласующий."

msgid "Only the requester can cancel."
msgstr "Отменить может только автор запроса."

msgid "Admin"
msgstr "Администратор"

msgid "Manager"
msgstr "Менеджер"

msgid "Pre-Close"
msgstr "Перед закрытием"

msgctxt "approval state"
msgid "Pending"
msgstr "Ожидает"

