msgstr "При ручном учёте времени укажите описание."

msgid "ended_at must be on or after started_at."
msgstr "ended_at должно быть не раньше started_at."

msgid "hourly_rate cannot be negative."
msgstr "hourly_rate не может быть отрицательным."

msgid "Description cannot be empty."
msgstr "Описание не может быть пустым."

msgid "Either stage_id or status must be provided"
msgstr "Укажите stage_id или status"

#, python-format
msgid "group_by must be one of %(choices)s."
msgstr "group_by должен быть одним из значений: %(choices)s."

msgid "No time entries supplied."
msgstr "Не переданы записи учёта времени."

#, python-format
msgid "Cannot invoice entries in multiple currencies: %(currencies)s."
msgstr "Нельзя выставить счёт по записям в разных валютах: %(currencies)s."

#, python-format
msgid "Time entry %(id)s has already been invoiced."
msgstr "По записи учёта времени %(id)s уже выставлен счёт."

#, python-format
msgid "Time entry %(id)s is still running and cannot be invoiced."
msgstr "Запись учёта времени %(id)s ещё идёт, по ней нельзя выставить счёт."

