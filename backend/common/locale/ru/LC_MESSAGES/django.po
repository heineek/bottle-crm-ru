msgstr ""
"Вашу учётную запись активировал пользователь %(status_changed_user)s. Теперь"
" вы можете войти и пользоваться всеми возможностями BottleCRM."

msgid "Log In"
msgstr "Войти"

msgid "Your BottleCRM account has been deactivated"
msgstr "Ваша учётная запись BottleCRM деактивирована"

msgid "Account Deactivated"
msgstr "Учётная запись деактивирована"

#, python-format
msgid ""
"Your account has been deactivated by %(status_changed_user)s. You'll receive"
