msgid "You can save at most %(max)d views for one list."
msgstr "Для одного списка можно сохранить не больше %(max)d представлений."

msgid "You already have a view with this name for this list."
msgstr "У вас уже есть представление с таким названием для этого списка."

msgid "A scope cannot be empty."
msgstr "Область доступа не может быть пустой."

#, python-format
msgid "Scope %(scope)s is not in <resource>:<action> form."
msgstr "Область доступа %(scope)s не в формате <resource>:<action>."

