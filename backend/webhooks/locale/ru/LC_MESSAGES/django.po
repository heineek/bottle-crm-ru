msgid "Leads"
msgstr "Лиды"

msgid "Contacts"
msgstr "Контакты"

msgid "Accounts"
msgstr "Компании"

msgid "Deals"
msgstr "Сделки"

msgid "Tickets"
msgstr "Обращения"

msgid "Invoices"
msgstr "Счета"

msgid "Tasks"
msgstr "Задачи"

msgid "Interactions"
msgstr "Взаимодействия"

msgid "The signing secret is generated by the server."
msgstr "Секрет для подписи создаёт сервер."

msgid "Choose at least one event."
msgstr "Выберите хотя бы одно событие."

#, python-format
msgid "Unknown event: %(events)s."
msgstr "Неизвестное событие: %(events)s."

msgid "Enter a valid URL."
msgstr "Введите корректный URL."

msgid "The URL must start with https://."
msgstr "URL должен начинаться с https://."

msgid "The URL must not contain a username or password."
msgstr "URL не должен содержать имя пользователя или пароль."

msgid "Enter a valid host name."
msgstr "Введите корректное имя хоста."

msgid "Only the standard HTTPS port (443) is allowed."
msgstr "Разрешён только стандартный порт HTTPS (443)."

msgid "The URL points at a private or reserved network address."
msgstr "URL указывает на частный или зарезервированный сетевой адрес."

msgid "The host name could not be resolved."
msgstr "Не удалось определить адрес по имени хоста."

#, python-format
msgid "An organization can have at most %(count)s webhook."
msgid_plural "An organization can have at most %(count)s webhooks."
msgstr[0] "В организации может быть не больше %(count)s вебхука."
msgstr[1] "В организации может быть не больше %(count)s вебхуков."
msgstr[2] "В организации может быть не больше %(count)s вебхуков."

msgid "No such webhook endpoint."
msgstr "Такой точки приёма вебхуков нет."

msgid "Turn the webhook on before sending a test."
msgstr "Включите вебхук, прежде чем отправлять тестовое сообщение."

msgid "This delivery is still being attempted."
msgstr "Эта доставка ещё выполняется."

msgid "Turn the webhook on before redelivering."
msgstr "Включите вебхук, прежде чем отправлять доставку повторно."
