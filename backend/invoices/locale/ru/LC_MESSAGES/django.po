msgstr "Создавать счета по записям учёта времени могут только администраторы."

msgid "Send either account_id or project_id."
msgstr "Передайте либо account_id, либо project_id."

#, python-format
msgid "group_by must be one of %(choices)s."
msgstr "group_by должен быть одним из значений: %(choices)s."

