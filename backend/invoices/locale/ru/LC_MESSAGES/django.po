#, python-format
msgid ""
"This estimate expired on %(date)s and can no longer be accepted. Please "
"request an updated quote."
msgstr ""
"Срок действия этого коммерческого предложения истёк %(date)s, принять его "
"уже нельзя. Запросите обновлённое предложение."

msgid "Your name and email are required to accept this estimate."
msgstr ""
"Чтобы принять коммерческое предложение, укажите имя и адрес эл. почты."

msgid "Please enter a valid email address."
msgstr "Введите корректный адрес эл. почты."

msgid "Estimate accepted successfully"
msgstr "Коммерческое предложение принято"

msgid "Estimate cannot be declined in current state"
msgstr "Коммерческое предложение нельзя отклонить в текущем статусе"

msgid "Estimate declined"
msgstr "Коммерческое предложение отклонено"

msgid "Use a six digit hex colour, for example #3B82F6."
msgstr "Укажите цвет шестью шестнадцатеричными цифрами, например #3B82F6."

msgid "Quantity must be more than zero."
msgstr "Количество должно быть больше нуля."

msgid "Unit price cannot be negative."
msgstr "Цена за единицу не может быть отрицательной."

msgid "A discount cannot be negative."
msgstr "Скидка не может быть отрицательной."

msgid "A percentage discount cannot exceed 100."
msgstr "Скидка в процентах не может превышать 100."

msgid "A discount cannot exceed the line's amount."
msgstr "Скидка не может превышать сумму позиции."

msgid "Product not found or does not belong to your organization"
msgstr "Товар не найден или не относится к вашей организации"

msgid "A line item references a product from another organization."
msgstr "Позиция ссылается на товар другой организации."

#, python-format
msgid ""
"This estimate is %(status)s. Its lines and amounts can only be changed while"
" it is a Draft."
msgstr ""
"Коммерческое предложение в статусе «%(status)s». Его позиции и суммы можно "
"менять только в черновике."

#, python-format
msgid ""
"This invoice is %(status)s. Its lines and amounts can only be changed while "
"it is a Draft."
msgstr ""
"Счёт в статусе «%(status)s». Его позиции и суммы можно менять только в "
"черновике."

msgid "A discount cannot exceed the subtotal."
msgstr "Скидка не может превышать промежуточный итог."

msgid "Contact not found, or you do not have access to it."
msgstr "Контакт не найден, или у вас нет к нему доступа."

msgid "Account not found, or you do not have access to it."
msgstr "Компания не найдена, или у вас нет к ней доступа."

msgid "Opportunity not found, or you do not have access to it."
msgstr "Сделка не найдена, или у вас нет к ней доступа."

msgid "Cannot record a payment against a cancelled invoice."
msgstr "Нельзя записать платёж по отменённому счёту."

msgid "Payment amount must be greater than zero."
msgstr "Сумма платежа должна быть больше нуля."

#, python-format
msgid "Payment amount exceeds the amount due (%(amount)s)."
msgstr "Сумма платежа превышает сумму к оплате (%(amount)s)."

msgid "Organization context required"
msgstr "Не выбрана организация"

msgid "Template not found or does not belong to your organization"
msgstr "Шаблон не найден или не относится к вашей организации"

msgid "Contact does not belong to the selected account"
msgstr "Контакт не относится к выбранной компании"

msgid "An estimate cannot expire before it is issued."
msgstr ""
"Срок действия коммерческого предложения не может закончиться раньше даты его"
" выставления."

msgid "Choose an account to start a project for."
msgstr "Выберите компанию, для которой начать проект."

msgid "Only an admin can start a project from an estimate."
msgstr ""
"Начать проект из коммерческого предложения может только администратор."

msgid ""
"A custom frequency needs an interval in days. Without one the schedule would"
" bill monthly."
msgstr ""
"Для своего интервала укажите число дней. Без него счета будут выставляться "
"ежемесячно."

msgid "The next generation date cannot be before the start date."
msgstr "Дата следующего счёта не может быть раньше даты начала."

msgid "Add at least one line before turning on auto-send."
msgstr "Перед включением автоотправки добавьте хотя бы одну позицию."

msgid "The end date must be on or after the start date."
msgstr "Дата окончания не может быть раньше даты начала."

